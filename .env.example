# ────────────────────────────────────────────────────────────
# Chai & Charcha — environment variables
# Copy to `.env.local` for local runs (VERCEL NEEDS THESE SET TOO).
# NEVER commit this file. `.env*` is already git-ignored.
# ────────────────────────────────────────────────────────────

# ── Supabase (mandatory) ────────────────────────────────────
# Project → Settings → API
# Publishable (anon) key — safe for the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...your-anon-key...

# Server-only secret — NEVER expose via the browser or Git.
# Used by Vercel Serverless functions (api/config + api/admin/*).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ── Admin secret-code login (mandatory) ─────────────────────
# The code typed on /admin/login.html. Verified server-side only.
# Choose something long & random (20+ chars).
ADMIN_CODE=CHANGE-ME-very-long-random-code

# The Supabase Auth user behind the admin session.
# Run: npm run setup:admin   (creates this user)
ADMIN_EMAIL=admin@chaiandcharcha.pk
ADMIN_PASSWORD=CHANGE-ME-strong-password

# ── Optional ────────────────────────────────────────────────
# Set to "false" only for local HTTP testing.
COOKIE_SECURE=true

# ── Visitor/login email alerts (existing api/notify.js) ─────
SENDGRID_API_KEY=
SENDER_EMAIL=
EMAIL_TO=